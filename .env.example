# ==============================================================================
# RAG Study Buddy - Production Environment Configuration Template
# Copy this file to .env for local development or set in cloud environment.
# NEVER commit real secret keys, passwords, or credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MANDATORY PRODUCTION SECRETS (Required for operation)
# ------------------------------------------------------------------------------
# Groq API Key for LLaMA-3.3-70B model inference (https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# MongoDB Connection URI
# Local dev default: mongodb://localhost:27017
# Production (e.g. MongoDB Atlas): mongodb+srv://<user>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017

# MongoDB Database Name
MONGODB_DB_NAME=rag_study_buddy

# JWT Secret Key for HMAC-SHA256 signature (min 32 random characters in production)
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=your_production_jwt_secret_key_min_32_chars

# ------------------------------------------------------------------------------
# 2. CORS & SECURITY CONFIGURATION
# ------------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins (no trailing slashes, NO wildcards "*")
# Example: https://study-buddy.vercel.app,http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# JWT token algorithm and expiry (in minutes; 1440 = 24 hours)
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# 3. RATE LIMITING (In-process sliding window protection)
# ------------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=30
RATE_LIMIT_UPLOAD_PER_MINUTE=15
RATE_LIMIT_CHAT_PER_MINUTE=45

# ------------------------------------------------------------------------------
# 4. RUNTIME & STORAGE CONFIGURATION
# ------------------------------------------------------------------------------
# APP_ENV: 'development' or 'production'
APP_ENV=development

# Server Port (assigned dynamically by Render / cloud platforms via $PORT)
PORT=8000

# Persistent storage paths (must be mounted to a persistent disk in production!)
# On Render: /var/data/faiss_index and /var/data/documents (backed by Render Disk)
FAISS_INDEX_PATH=./data/faiss_index
DOCUMENT_STORAGE_PATH=./data/documents

# Maximum document upload size in bytes (10MB default)
MAX_UPLOAD_SIZE_BYTES=10485760

# Chunking configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
MAX_CHUNKS_PER_DOCUMENT=5000

# ------------------------------------------------------------------------------
# 5. RAG & LLM TUNING
# ------------------------------------------------------------------------------
# Production sentence embeddings (384-dimensional dense vectors, normalized IP)
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Maximum relevant chunks retrieved per query
RETRIEVER_TOP_K=3

# Production Groq LLM model
GROQ_MODEL=llama-3.3-70b-versatile

# Maximum context length passed into prompt (characters)
RAG_MAX_CONTEXT_CHARS=4000

# Chat history window limit (messages injected into context)
CHAT_HISTORY_LIMIT=10
